# Copy to .env and fill in. See README.md for the full walkthrough.

# PostgreSQL connection string (Neon pooled URL works well with the pg adapter).
DATABASE_URL="postgresql://user:password@localhost:5432/finance_tracker"

# Session encryption secret. Generate: npx auth secret
AUTH_SECRET=""

# GitHub OAuth app. Callback URL:
# http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
